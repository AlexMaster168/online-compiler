DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=online_compiler
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# auto | docker | local  (local — НЕ песочница, только для разработки)
EXECUTOR_BACKEND=auto
EXECUTOR_RUN_TIMEOUT=10
EXECUTOR_COMPILE_TIMEOUT=30
EXECUTOR_MEMORY_MB=512
EXECUTOR_MAX_CONCURRENT=4
EXECUTOR_RATE_LIMIT_PER_MINUTE=30

# Почта для сброса пароля (без EMAIL_HOST письма печатаются в консоль сервера)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Online Compiler <noreply@example.com>

# Вход через GitHub / Google: callback — <сайт>/auth/github/callback/ и <сайт>/auth/google/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
