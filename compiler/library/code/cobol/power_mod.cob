*> Быстрое возведение в степень: O(log n). Промежуточные произведения COBOL считает в десятичной
*> арифметике с запасом разрядов — переполнения 64 бит тут нет в принципе.
IDENTIFICATION DIVISION.
PROGRAM-ID. POWER-MOD.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-MOD      PIC 9(10) VALUE 1000000007.
01 WS-BASE     PIC 9(18).
01 WS-EXP      PIC 9(18).
01 WS-RESULT   PIC 9(18).
01 WS-OUT1     PIC Z(17)9.
01 WS-OUT2     PIC Z(17)9.
PROCEDURE DIVISION.
    MOVE 2 TO WS-BASE
    MOVE 30 TO WS-EXP
    PERFORM POW-MOD
    MOVE WS-MOD TO WS-OUT1
    MOVE WS-RESULT TO WS-OUT2
    DISPLAY "2^30 mod " FUNCTION TRIM(WS-OUT1) " = " FUNCTION TRIM(WS-OUT2)
    MOVE 3 TO WS-BASE
    MOVE 200 TO WS-EXP
    PERFORM POW-MOD
    MOVE WS-RESULT TO WS-OUT2
    DISPLAY "3^200 mod " FUNCTION TRIM(WS-OUT1) " = " FUNCTION TRIM(WS-OUT2)
    STOP RUN.

POW-MOD.
    MOVE 1 TO WS-RESULT
    COMPUTE WS-BASE = FUNCTION MOD(WS-BASE, WS-MOD)
    PERFORM UNTIL WS-EXP = 0
        IF FUNCTION MOD(WS-EXP, 2) = 1
            COMPUTE WS-RESULT = FUNCTION MOD(WS-RESULT * WS-BASE, WS-MOD)
        END-IF
        COMPUTE WS-BASE = FUNCTION MOD(WS-BASE * WS-BASE, WS-MOD)
        COMPUTE WS-EXP = WS-EXP / 2
    END-PERFORM.
